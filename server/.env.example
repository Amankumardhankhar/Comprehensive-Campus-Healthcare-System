NODE_ENV=development
PORT=5050

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campus-healthcare?retryWrites=true&w=majority

JWT_SECRET=generate_a_strong_random_secret_here
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

# Public base URL used to build password-reset links in emails.
# MUST match the address users actually browse to, or every reset link is dead.
APP_URL=http://localhost:5173

# ── Email delivery ────────────────────────────────────────────────
# Transport is picked in this order: Brevo → SMTP → Resend → console.
# With none set, reset links are printed to the server log instead.
#
# Brevo sends over HTTPS (port 443). Prefer it on container platforms:
# Hugging Face Spaces blocks outbound SMTP on both 587 and 465, so the
# SMTP transport below cannot connect there at all. Brevo also supports
# verifying a single sender address, so no domain is required.
BREVO_API_KEY=
#
# Gmail: enable 2-Step Verification, then create an App Password at
# Google Account → Security → App passwords. Use that 16-char value,
# NOT the account password.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Alternative transport. Note that Resend's shared onboarding@resend.dev
# sender only delivers to your own Resend account address — a verified
# domain is required to reach anyone else.
RESEND_API_KEY=

# Defaults to "Campus Healthcare <SMTP_USER>" when SMTP is configured.
EMAIL_FROM=

AI_RISK_URL=http://localhost:8001
AI_TREND_URL=http://localhost:8002
AI_FORECAST_URL=http://localhost:8003
