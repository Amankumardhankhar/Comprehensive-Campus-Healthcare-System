# ───────────────────────────────────────────────────────────────
# Production environment for docker-compose (single-VM deploy).
# On the server:  cp .env.example .env   then fill in the values.
# .env is gitignored — never commit real secrets.
#
# MongoDB runs as a bundled container — no MONGO_URI needed here.
# ───────────────────────────────────────────────────────────────

# Auth — generate a strong secret with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Public origin where the app is reached (used for CORS and for
# building password-reset links). Set both to the same value:
#   - http://<your-vm-public-ip>:5050   (quick start)
#   - https://your-domain.example.com   (once you have a domain / tunnel)
CLIENT_URL=http://<your-vm-public-ip>:5050
APP_URL=http://<your-vm-public-ip>:5050

# ── Password-reset email delivery ─────────────────────────────────
# Transport is picked in this order: SMTP → Resend → console.
# With none set, reset links are logged to the container console.

# Option 1 (recommended, no domain needed) — SMTP via Gmail.
# Enable 2-Step Verification on the account, then create an App Password
# at Google Account → Security → App passwords. Use that 16-char value
# below, NOT the account password. Free Gmail sends ~500/day.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Option 2 — Resend (https://resend.com). The shared onboarding@resend.dev
# sender only delivers to your own Resend account address; reaching anyone
# else requires verifying a domain you own.
RESEND_API_KEY=

# Defaults to "Campus Healthcare <SMTP_USER>" when SMTP is configured.
EMAIL_FROM=
